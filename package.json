{
	"name": "au2-ex1",
	"description": "An Aurelia 2 client application.",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "???"
	},
	"license": "UNLICENSED",
	"dependencies": {
		"@aurelia/router": "2.0.0-rc.0",
		"@fortawesome/fontawesome-free": "^7.2.0",
		"@popperjs/core": "^2.11.8",
		"aurelia": "2.0.0-rc.0",
		"aurelia2-google-maps": "^1.0.0",
		"bootstrap": "^5.3.8"
	},
	"devDependencies": {
		"@aurelia/testing": "2.0.0-rc.0",
		"@aurelia/ts-jest": "2.0.0-rc.0",
		"@aurelia/webpack-loader": "2.0.0-rc.0",
		"@playwright/test": "^1.59.1",
		"@types/bootstrap": "^5.2.10",
		"@types/google.maps": "^3.58.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.5.0",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"autoprefixer": "^10.4.27",
		"css-loader": "^7.1.4",
		"dotenv-webpack": "^9.0.0",
		"eslint": "^10.1.0",
		"html-webpack-plugin": "^5.6.6",
		"htmlhint": "^1.9.2",
		"jest": "^30.3.0",
		"jest-environment-jsdom": "^30.3.0",
		"jest-transform-stub": "^2.0.0",
		"less": "^4.6.4",
		"less-loader": "^12.3.2",
		"postcss": "^8.5.8",
		"postcss-loader": "^8.2.1",
		"rimraf": "^6.1.3",
		"sass": "^1.99.0",
		"sass-loader": "^16.0.7",
		"style-loader": "^4.0.0",
		"ts-loader": "^9.5.7",
		"typescript": "^6.0.2",
		"webpack": "^5.105.4",
		"webpack-bundle-analyzer": "^5.3.0",
		"webpack-cli": "^7.0.2",
		"webpack-dev-server": "^5.2.3"
	},
	"scripts": {
		"lint:js": "eslint --format stylish --stats src test",
		"lint:html": "htmlhint -c .htmlhintrc src",
		"lint": "npm run lint:js && npm run lint:html",
		"pretest": "npm run lint",
		"start": "webpack serve",
		"build": "rimraf dist && webpack --env production",
		"analyze": "rimraf dist && webpack --env production --analyze",
		"test": "jest",
		"docker:build-image": "docker build -t au2-ex1 .",
		"docker:run-container": "docker run -d -p 7000:80 au2-ex1"
	},
	"jest": {
		"testEnvironment": "jsdom",
		"transform": {
			"\\.(css|less|sass|scss|styl|jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "jest-transform-stub",
			"\\.(ts|html)$": "@aurelia/ts-jest"
		},
		"collectCoverage": true,
		"collectCoverageFrom": [
			"src/**/*.ts",
			"!src/**/*.d.ts"
		],
		"globals": {
			"ts-jest": {
				"isolatedModules": true
			}
		},
		"testPathIgnorePatterns": [
			"<rootDir>/node_modules/",
			"<rootDir>/e2e/",
			"<rootDir>/tests-examples/"
		]
	},
	"packageManager": "yarn@4.13.0"
}
