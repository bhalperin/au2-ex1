{
	"compilerOptions": {
		"moduleResolution": "nodenext",
		"skipLibCheck": true,
		"target": "es2022",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"module": "nodenext",
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node", "@types/google.maps", "@types/jest"]
	},
	"include": ["test", "e2e", "src"],
